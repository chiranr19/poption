# Copy to backend/.env and fill in. Never commit the real .env.

# Anthropic Claude API key — powers the forensic explanations.
# The app runs without it (forensics endpoint returns a stub),
# but explanations are the whole point, so set it for anything real.
ANTHROPIC_API_KEY=

# Frontend origin allowed for CORS + WebSocket handshake.
CORS_ORIGIN=http://localhost:5173
